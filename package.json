{
  "name": "openmats-helsinki-region",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "automation:gate": "node scripts/automation-gate.mjs",
    "automation:github-preflight": "node scripts/github-preflight.mjs",
    "automation:verify-production": "node scripts/verify-production.mjs",
    "audit:security": "pnpm audit --audit-level high",
    "events:refresh": "node scripts/materialize-events.mjs refresh",
    "events:check": "node scripts/materialize-events.mjs check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm events:check && pnpm format:check && pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "astro": "7.1.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
