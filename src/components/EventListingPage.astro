---
import { getCollection } from "astro:content";
import automationState from "../../data/automation-state.json";

import EventCard from "./EventCard.astro";
import FilterBar from "./FilterBar.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  findDuplicateEventIds,
  isUpcomingEvent,
  sortEvents,
} from "../lib/events";
import { intlLocale, ui, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const buildTime = new Date();
const events = sortEvents(
  (await getCollection("events")).filter((event) =>
    isUpcomingEvent(event.data.endAt, buildTime),
  ),
  (event) => event.data.startAt,
);
const duplicates = findDuplicateEventIds(
  events.map((event) => ({
    id: event.id,
    title: event.data.title,
    formats: event.data.formats,
    startAt: event.data.startAt,
    venue: event.data.venue,
  })),
);
const lastSuccessfulReviewAt = [
  automationState.routine.lastSuccessfulAt,
  automationState.discovery.lastSuccessfulAt,
].sort((first, second) => Date.parse(second) - Date.parse(first))[0];
const latestVerificationDate = new Intl.DateTimeFormat(intlLocale[locale], {
  dateStyle: "long",
  timeZone: "Europe/Helsinki",
}).format(new Date(lastSuccessfulReviewAt));

if (duplicates.length > 0) {
  throw new Error(
    `Duplicate event identities found: ${JSON.stringify(duplicates)}`,
  );
}
---

<BaseLayout
  title="Open Mats — Helsinki Region"
  description={copy.description}
  locale={locale}
>
  <SiteHeader locale={locale} />

  <main>
    <section class="hero">
      <div class="hero__content">
        <p class="eyebrow">Helsinki · Espoo · Vantaa</p>
        <h1>{copy.heroTitle}{" "}<br /><em>{copy.heroOpenMat}</em></h1>
        <p class="hero__lead">{copy.heroLead}</p>
        <a class="hero__action" href="#events"
          >{copy.heroAction} <span aria-hidden="true">↓</span></a
        >
      </div>
    </section>

    <aside
      class="example-notice"
      role="note"
      aria-label={copy.noticeLabel}
      data-last-reviewed-at={lastSuccessfulReviewAt}
    >
      <span aria-hidden="true">i</span>
      <div>
        <strong>
          {
            latestVerificationDate &&
              `${copy.lastChecked} ${latestVerificationDate}. `
          }
          {copy.sourceReminder}
        </strong>
      </div>
    </aside>

    <section class="events-section" id="events" aria-labelledby="events-title">
      <div class="section-intro">
        <h2 class="eyebrow" id="events-title">{copy.upcoming}</h2>
      </div>

      <FilterBar locale={locale} />

      <div class="event-list" data-event-list>
        {events.map((event) => <EventCard event={event} locale={locale} />)}
      </div>

      <p
        class="sr-only"
        data-results-announcement
        aria-live="polite"
        aria-atomic="true"
      >
      </p>

      <div class="pagination" data-pagination hidden>
        <p data-page-summary></p>
        <nav class="pagination__controls" aria-label={copy.paginationLabel}>
          <button type="button" data-page-action="previous"
            >← {copy.previous}</button
          >
          <p class="pagination__page">
            <span>{copy.page}</span>
            {" "}
            <strong data-current-page>1</strong>
            {" "}
            <span aria-hidden="true">/</span>
            {" "}
            <span data-total-pages>1</span>
          </p>
          <button type="button" data-page-action="next">{copy.next} →</button>
        </nav>
      </div>

      <div class="empty-state" data-empty-state hidden>
        <strong>{copy.emptyTitle}</strong>
        <p>{copy.emptyLead}</p>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} />

  <script>
    import { matchesEventFilters } from "../lib/event-filtering";
    import { EVENTS_PER_PAGE, getPaginationState } from "../lib/pagination";

    const filterState = { city: "all", format: "all" };
    const selectedPriceCategories = new Set(["free", "paid", "unknown"]);
    let currentPage = 1;
    let expiryTimer: number | undefined;
    const cards = [...document.querySelectorAll("[data-event-card]")];
    const eventList = document.querySelector("[data-event-list]");
    const emptyState = document.querySelector("[data-empty-state]");
    const pagination = document.querySelector("[data-pagination]");
    const pageSummary = document.querySelector("[data-page-summary]");
    const resultsAnnouncement = document.querySelector(
      "[data-results-announcement]",
    );
    const currentPageLabel = document.querySelector("[data-current-page]");
    const totalPagesLabel = document.querySelector("[data-total-pages]");
    const previousButton = document.querySelector(
      '[data-page-action="previous"]',
    );
    const nextButton = document.querySelector('[data-page-action="next"]');

    function updateResults() {
      const matchingCards = cards.filter((card) => {
        if (!(card instanceof HTMLElement)) return false;

        return matchesEventFilters(
          {
            city: card.dataset.city ?? "",
            formats: card.dataset.formats?.split(" ").filter(Boolean) ?? [],
            priceCategory: card.dataset.priceCategory ?? "unknown",
            endAt: card.dataset.endAt ?? "",
          },
          filterState,
          selectedPriceCategories,
          Date.now(),
        );
      });
      const pageState = getPaginationState(
        matchingCards.length,
        currentPage,
        EVENTS_PER_PAGE,
      );
      currentPage = pageState.page || 1;
      const pageCards = new Set(
        matchingCards.slice(pageState.startIndex, pageState.endIndex),
      );

      for (const card of cards) {
        if (card instanceof HTMLElement) card.hidden = !pageCards.has(card);
      }

      if (emptyState instanceof HTMLElement)
        emptyState.hidden = matchingCards.length !== 0;
      if (pagination instanceof HTMLElement)
        pagination.hidden = pageState.totalPages <= 1;
      const summary =
        document.documentElement.lang === "en"
          ? `Showing ${pageState.firstItem}–${pageState.lastItem} of ${matchingCards.length} events`
          : `Näytetään ${pageState.firstItem}–${pageState.lastItem} / ${matchingCards.length} tapahtumaa`;
      if (pageSummary) pageSummary.textContent = summary;
      if (resultsAnnouncement) resultsAnnouncement.textContent = summary;
      if (currentPageLabel)
        currentPageLabel.textContent = String(pageState.page);
      if (totalPagesLabel)
        totalPagesLabel.textContent = String(pageState.totalPages);
      if (previousButton instanceof HTMLButtonElement)
        previousButton.disabled = pageState.page <= 1;
      if (nextButton instanceof HTMLButtonElement)
        nextButton.disabled = pageState.page >= pageState.totalPages;

      scheduleNextExpiry();

      return [...pageCards].filter(
        (card): card is HTMLElement => card instanceof HTMLElement,
      );
    }

    function scheduleNextExpiry() {
      if (expiryTimer !== undefined) window.clearTimeout(expiryTimer);

      const now = Date.now();
      const nextEndAt = cards
        .filter((card): card is HTMLElement => card instanceof HTMLElement)
        .map((card) => Date.parse(card.dataset.endAt ?? ""))
        .filter((endAt) => Number.isFinite(endAt) && endAt > now)
        .sort((first, second) => first - second)[0];
      if (nextEndAt === undefined) return;

      expiryTimer = window.setTimeout(
        () => updateResults(),
        Math.min(nextEndAt - now + 100, 2_147_000_000),
      );
    }

    function changePage(direction: number) {
      currentPage += direction;
      const visibleCards = updateResults();
      const firstCard = visibleCards[0];
      if (firstCard) {
        firstCard.focus({ preventScroll: true });
      }
      if (eventList instanceof HTMLElement) {
        eventList.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
            .matches
            ? "auto"
            : "smooth",
          block: "start",
        });
      }
    }

    previousButton?.addEventListener("click", () => changePage(-1));
    nextButton?.addEventListener("click", () => changePage(1));

    for (const group of document.querySelectorAll("[data-filter-group]")) {
      if (!(group instanceof HTMLElement)) continue;
      const filterName = group.dataset.filterGroup;
      if (
        filterName !== "city" &&
        filterName !== "format" &&
        filterName !== "price"
      )
        continue;

      for (const button of group.querySelectorAll(
        "button[data-filter-value]",
      )) {
        button.addEventListener("click", () => {
          if (!(button instanceof HTMLButtonElement)) return;

          if (filterName === "price") {
            const priceCategory = button.dataset.filterValue;
            if (!priceCategory) return;

            if (selectedPriceCategories.has(priceCategory)) {
              selectedPriceCategories.delete(priceCategory);
            } else {
              selectedPriceCategories.add(priceCategory);
            }
            button.setAttribute(
              "aria-pressed",
              String(selectedPriceCategories.has(priceCategory)),
            );
            currentPage = 1;
            updateResults();
            return;
          }

          filterState[filterName] = button.dataset.filterValue ?? "all";
          currentPage = 1;
          for (const sibling of group.querySelectorAll(
            "button[data-filter-value]",
          )) {
            sibling.setAttribute("aria-pressed", String(sibling === button));
          }
          updateResults();
        });
      }
    }

    window.addEventListener("pagehide", () => {
      if (expiryTimer !== undefined) window.clearTimeout(expiryTimer);
    });

    updateResults();
  </script>
</BaseLayout>
